{
  "name": "hampton-roads-rentals",
  "version": "1.0.0",
  "private": true,
  "description": "Personal apartment aggregator for Virginia Beach / Norfolk / Ocean View, VA",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite build --watch",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx src/server/index.ts",
    "scrape": "tsx src/cli/scrape.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "leaflet": "^1.9.4",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
